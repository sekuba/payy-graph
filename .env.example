# JSON-RPC endpoints for the two chains the Payy Rollup settled on
ETHEREUM_RPC_URL=
POLYGON_RPC_URL=
# Chains that deposits are bridged from (optional): who funded each bridged
# deposit is looked up there. Ethereum and Polygon use the two above.
BASE_RPC_URL=
ARBITRUM_RPC_URL=
OPTIMISM_RPC_URL=
BSC_RPC_URL=
# Payy node API (public)
PAYY_NODE_URL=https://validators.mainnet.payy.network/v0
# SQLite file
PAYY_GRAPH_DB=data/payy-graph.sqlite
PORT=3020
# Address the API listens on; keep it local when a tunnel fronts it
HOST=127.0.0.1
# Browser origin allowed to call the API, e.g. the Pages site (or *)
CORS_ORIGIN=
# Only for `pnpm dev labels`, which rebuilds src/labels.generated.ts
ETHERSCAN_API_KEY=
